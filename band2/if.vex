def LMT_BAND2_IF; * Lm
     if_def = &IF_BAND2L : A : L : 228100.000000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND2R : B : R : 228100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
