$MODE;
*
def mode1mm;  * EHTC Band 3
     ref $PROCEDURES = Mode_01;
     ref $FREQ = STD_BAND3:Pv:Sz:Lm:Mg:Sw;
     ref $FREQ = GLT_BAND3:Gl;
     ref $FREQ = AX_BAND3:Ax;
*    ref $FREQ = PV_BAND3:Pv;
     ref $FREQ = ALMA_BAND3:Aa;
     ref $FREQ = JCMT_BAND3R:Mm;
     ref $FREQ = NOEMA_BAND3:Nq;
     ref $IF = STD_IF:Ax:Pv:Sz:Lm:Mg:Sw;
     ref $IF = GLT_IF:Gl;
     ref $IF = ALMA_IF:Aa;
     ref $IF = JCMT_IFR:Mm;
     ref $IF = NOEMA_IF:Nq;
     ref $BBC = COMMON_BBC:Ax:Pv:Gl:Sz:Mg:Sw:Nq;
     ref $BBC = REVERSE_BBC:Lm;
     ref $BBC = COMMON_BBC_R:Mm;
     ref $BBC = ALMA_BBC:Aa;
     ref $TRACKS = VDIF.8224:Ax:Pv:Gl:Sz:Lm:Mg:Mm:Sw:Nq;
     ref $TRACKS = VDIF.8032:Aa;
     ref $PHASE_CAL_DETECT = NoDetect:Ax:Pv:Gl:Aa:Sz:Lm:Mg:Mm:Sw:Nq;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*------------------------------------------------------------------------------
$DAS;
*
def 2NONE<;
     record_transport_type = Mark6;
     electronics_rack_type = none;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*
def 2NONE<#02;
     record_transport_type = Mark5C;
     electronics_rack_type = none;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*------------------------------------------------------------------------------
