*
def GLT_BAND4;
     sample_rate =  4096.000 Ms/sec;
     * Nominal EHTC LO band4 is 1st LO 221.100 GHz
     * GLT used ~222.100 GHz (222.099 999 000 GHz) hence +1 GHz LO off and -1 kHz LO fine off
     * 222.100 + 8.150 = 230.250
     * ---------------------------------------------------------------------------
     * Cannot correlate with 230.249999 GHz LSB since FFT freq grid 15.625 KHz not 1 kHz
     * Set fake freq here in VEX and pair it with v2d loOffset
     chan_def = &B:230250.00 MHz : L : 2048.00 MHz : &CH01 : &BBC01 : &NoCal;
     chan_def = &B:230250.00 MHz : L : 2048.00 MHz : &CH02 : &BBC02 : &NoCal;
enddef;
