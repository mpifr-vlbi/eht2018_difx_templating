*------------------------------------------------------------------------------
$BBC;
*
def COMMON_BBC;
     BBC_assign = &BBC01 : 1 : &IF_BAND3L;
     BBC_assign = &BBC02 : 2 : &IF_BAND3R;
enddef;
def REVERSE_BBC;
     BBC_assign = &BBC01 : 1 : &IF_BAND3R;
     BBC_assign = &BBC02 : 2 : &IF_BAND3L;
enddef;
def COMMON_BBC_L;
     BBC_assign = &BBC01 : 1 : &IF_BAND3L;
enddef;
def COMMON_BBC_R;
     BBC_assign = &BBC02 : 2 : &IF_BAND3R;
enddef;
def ALMA_BBC;   * Aa
     BBC_assign = &BBC05 : 5 : &IF_Q3X;
     BBC_assign = &BBC06 : 6 : &IF_Q3Y;
enddef;
*------------------------------------------------------------------------------
$IF;
*
def STD_IF;
     if_def = &IF_BAND3L : A : L : 228100.000000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND3R : B : R : 228100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
def GLT_IF;
     if_def = &IF_BAND3L : A : L : 225949.999000 MHz : U : 0 MHz : 0 Hz;
     if_def = &IF_BAND3R : B : R : 225949.999000 MHz : U : 0 MHz : 0 Hz;
enddef;
def JCMT_IFR;
     if_def = &IF_BAND3R : A : R : 228250.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
def JCMT_IFL;
     if_def = &IF_BAND3L : A : L : 228250.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
def ALMA_IF; * Aa
     if_def = &IF_Q3X : E : X : 226160.546875 MHz : U : 0 MHz : 0 Hz;
     if_def = &IF_Q3Y : F : Y : 226160.546875 MHz : U : 0 MHz : 0 Hz;
enddef;
