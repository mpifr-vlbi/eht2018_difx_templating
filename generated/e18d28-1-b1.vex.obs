*------------------------------------------------------------------------------
$BBC;
*
def COMMON_BBC_1POL_L;
     BBC_assign = &BBC01 : 1 : &IF_BAND1L;
enddef;
def COMMON_BBC_1POL_R;
     BBC_assign = &BBC01 : 1 : &IF_BAND1R;
enddef;
*
def COMMON_BBC; * RCP in v2d datastream 1, LCP in v2d datastream 2
     BBC_assign = &BBC01 : 1 : &IF_BAND1L;
     BBC_assign = &BBC02 : 2 : &IF_BAND1R;
enddef;
*
def REVERSE_BBC; * RCP in v2d datastream 2, LCP in v2d datastream 1
     BBC_assign = &BBC01 : 1: &IF_BAND1R;
     BBC_assign = &BBC02 : 2: &IF_BAND1L;
enddef;
*
def ALMA_BBC;   * Aa
     BBC_assign = &BBC05 : 5 : &IF_Q3X;
     BBC_assign = &BBC06 : 6 : &IF_Q3Y;
enddef;
*------------------------------------------------------------------------------
$IF;
*
def LMT_BAND1_IF; * Lm
     if_def = &IF_BAND1L : A : L : 228100.000000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND1R : B : R : 228100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def PV_BAND1_IF;
     if_def = &IF_BAND1L : A : L : 221100.000000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND1R : B : R : 221100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def SMA_BAND1_IF; * Sw
     if_def = &IF_BAND1L : A : L : 221100.000000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND1R : B : R : 221100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def JCMT_BAND1_IFR;
     if_def = &IF_BAND1R : A : R : 221100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def JCMT_BAND1_IFL;
     if_def = &IF_BAND1L : A : L : 222100.000000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def AX_BAND1_IF;
     if_def = &IF_BAND1L : A : L : 221103.000015 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND1R : B : R : 221103.000015 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def GLT_BAND1_IF;
     * https://eht-wiki.haystack.mit.edu/Event_Horizon_Telescope_Home/Observing/2018_April/GLT
     * 1st LO: 222.099 999 000 GHz
     * 2nd LO (Lower band): 3.850 000 000 GHz
     * 2nd LO (Higher band): 8.150 000 000 GHz
     if_def = &IF_BAND1L : A : L : 222099.999000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND1R : B : R : 222099.999000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def ALMA_BAND1_IF; * Aa
     if_def = &IF_Q3X : E : X : 228160.546875 MHz : U : 0 MHz : 0 Hz;
     if_def = &IF_Q3Y : F : Y : 228160.546875 MHz : U : 0 MHz : 0 Hz;
enddef;
