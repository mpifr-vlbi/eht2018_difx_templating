      addZoomFreq = freq@229744.828125/bw@58.0/noparent@true  #< 229802.828125
      addZoomFreq = freq@229803.421875/bw@58.0/noparent@true  #< 229861.421875
      addZoomFreq = freq@229862.015625/bw@58.0/noparent@true  #< 229920.015625
      addZoomFreq = freq@229920.609375/bw@58.0/noparent@true  #< 229978.609375
      addZoomFreq = freq@229979.203125/bw@58.0/noparent@true  #< 230037.203125
}

ANTENNA Ax {
  datastreams = Ax_ds12,Ax_ds34
  phaseCalInt = 0
  zoom = zooms
  loOffsets = +15.022,+15.022 # c21,e22: 15.022 Hz, a24,c25,...: 0 Hz
}
ANTENNA Aa {
  datastreams = Aa_ds12,Aa_ds34
  phaseCalInt = 0
  zoom = zooms
  ## Band 1
  # loOffsets = -0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05
  ## Band 2
  # loOffsets = -0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05,-0.05
  ## Band 3
  # loOffsets = +0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05
  ## Band 4
  loOffsets = +0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05,+0.05
}
ANTENNA Pv {
  datastreams = Pv_ds12, Pv_ds34
  phaseCalInt = 0
  zoom = zooms
}
ANTENNA Gl {
  datastreams = Glt_ds12,Glt_ds34
  phaseCalInt = 0
  zoom = zooms
  # VEX file was set to 230.250 GHz LSB while actually observed 230.249999 GHz LSB
  loOffsets = -1000,-1000
}
ANTENNA Lm {
  datastreams = Lmt_ds12,Lmt_ds34
  phaseCalInt = 0
  zoom = zooms
  # loOffsets = -0.11,-0.11    tentative a priori added by V.Fish eht-wiki 30 Apr 2018
  # loOffsets = -0.018,-0.018  better fitting prior
  loOffsets = 0,0  # most likely
}
ANTENNA Mm { # JCMT
  datastreams = Jcmt_ds12
  phaseCalInt = 0
  zoom = zooms
  loOffsets = +117.0
}
ANTENNA Sw { # SMA APHIDS
  datastreams = SmaAphids_ds12,SmaAphids_ds34
  phaseCalInt = 0
  zoom = zooms
  deltaClock = +0.218 # SMA extra offsets
  loOffsets = 0,0
}
ANTENNA Mg { # SMT
  datastreams = Smt_ds12,Smt_ds34
  phaseCalInt = 0
  zoom = zooms
  loOffsets = 0,0
}
ANTENNA Sz { # SPT
  datastreams = Spt_ds12,Spt_ds34
  phaseCalInt = 0
  zoom = zooms
  loOffsets = 0,0
}

DATASTREAM Ax_ds12 {
  filelist = ehtc2018_APEX_band4.12.filelist
}
DATASTREAM Ax_ds34 {
  filelist = ehtc2018_APEX_band4.34.filelist
}
DATASTREAM Pv_ds12 {
  filelist = ehtc2018_Pico_band4.12.filelist
}
DATASTREAM Pv_ds34 {
  filelist = ehtc2018_Pico_band4.34.filelist
}
DATASTREAM Glt_ds12 {
  filelist = ehtc2018_GLT_band4.12.filelist-beegfs
}
DATASTREAM Glt_ds34 {
  filelist = ehtc2018_GLT_band4.34.filelist-beegfs
}
DATASTREAM Lmt_ds12 {
  filelist = ehtc2018_LMT_band4.12.filelist
}
DATASTREAM Lmt_ds34 {
  filelist = ehtc2018_LMT_band4.34.filelist
}
DATASTREAM Jcmt_ds12 {
  # MM module says "b1 & b4 DSB"
  # IF signal has band 1 folded on top of band 4
  filelist = ehtc2018_Jcmt_band14.12.filelist-beegfs
}
DATASTREAM SmaAphids_ds12 {
  filelist = ehtc2018_SMA_band4.12.filelist
}
DATASTREAM SmaAphids_ds34 {
  filelist = ehtc2018_SMA_band4.34.filelist
}
DATASTREAM Smt_ds12 {
  filelist = ehtc2018_SMT_band4.12.filelist
}
DATASTREAM Smt_ds34 {
  filelist = ehtc2018_SMT_band4.34.filelist
}
DATASTREAM Aa_ds12 {
  filelist = ehtc2018_ALMA_set1_band4.12.filelist
}
DATASTREAM Aa_ds34 {
  filelist = ehtc2018_ALMA_set1_band4.34.filelist
}
DATASTREAM Spt_ds12 {
  filelist = ehtc2018_SPT_set1_band4.12.filelist
}
DATASTREAM Spt_ds34 {
  filelist = ehtc2018_SPT_set1_band4.34.filelist
}


SETUP MHz58 {
  numBufferedFFTs = 20
  tInt = 0.400
  subintNS =  3200000
  FFTSpecRes = 0.015625
  outputSpecRes = 0.5
  xmacLength = 0
  strideLength = 0
  guardNS = 2000

  # outputSpecRes = 0.0625 # fringe search, ~1000 ch over 58 MHz
  # outputSpecRes = 0.0156250 # fringe search, ~4000 ch over 58 MHz
}

RULE defaultRule {
  setup = MHz58
}
