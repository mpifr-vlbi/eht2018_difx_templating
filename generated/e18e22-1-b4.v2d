      addZoomFreq = freq@229041.703125/bw@58.0/noparent@true  #< 229099.703125
      addZoomFreq = freq@229100.296875/bw@58.0/noparent@true  #< 229158.296875
      addZoomFreq = freq@229158.890625/bw@58.0/noparent@true  #< 229216.890625
