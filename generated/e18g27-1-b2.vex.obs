enddef;
*
def GLT_BAND2_IF;
     * https://eht-wiki.haystack.mit.edu/Event_Horizon_Telescope_Home/Observing/2018_April/GLT
     * 1st LO: 222.099 999 000 GHz
     * 2nd LO (Lower band): 3.850 000 000 GHz
     * 2nd LO (Higher band): 8.150 000 000 GHz
     if_def = &IF_BAND2L : A : L : 222099.999000 MHz : L : 0 MHz : 0 Hz;
     if_def = &IF_BAND2R : B : R : 222099.999000 MHz : L : 0 MHz : 0 Hz;
enddef;
*
def ALMA_BAND2_IF; * Aa
     if_def = &IF_Q3X : E : X : 228160.546875 MHz : U : 0 MHz : 0 Hz;
     if_def = &IF_Q3Y : F : Y : 228160.546875 MHz : U : 0 MHz : 0 Hz;
enddef;
