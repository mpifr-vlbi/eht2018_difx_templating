}
ANTENNA Pv {
  datastreams = Pv_ds12, Pv_ds34
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}
ANTENNA Gl {
  datastreams = Glt_ds12,Glt_ds34
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
  loOffsets = -1000.,-1000.
}
ANTENNA Lm {
  datastreams = Lmt_ds12,Lmt_ds34
# speculative LO offset
# loOffsets = -0.11, -0.11   # from e18c21-0-b2.v2d, was commented out there as well
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}
ANTENNA Mm { # JCMT
  datastreams = Jcmt_ds34
  loOffsets = +117.0
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}
ANTENNA Sw { # SMA APHIDS
  datastreams = SmaAphids_ds12,SmaAphids_ds34
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}
ANTENNA Mg { # SMT
  datastreams = Smt_ds12,Smt_ds34
# loOffsets = 0.008, 0.008
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}
ANTENNA Sz { # SPT
  datastreams = Spt_ds12,Spt_ds34
  phaseCalInt = 0
  toneSelection = none
  zoom = zooms
}

DATASTREAM Ax_ds12 {
  filelist = ../../filelists/mod-12-Ax.b3.flist
}
DATASTREAM Ax_ds34 {
  filelist = ../../filelists/mod-34-Ax.b3.flist
}
DATASTREAM Pv_ds12 {
  filelist = ../../filelists/mod-12-Pv.b3.flist
}
DATASTREAM Pv_ds34 {
  filelist = ../../filelists/mod-34-Pv.b3.flist
}
DATASTREAM Glt_ds12 {
  filelist = ../../filelists/mod-12-Gl.b3.flist
}
DATASTREAM Glt_ds34 {
  filelist = ../../filelists/mod-34-Gl.b3.flist
}
DATASTREAM Lmt_ds12 {
  filelist = ../../filelists/mod-12-Lm.b3.flist
}
DATASTREAM Lmt_ds34 {
  filelist = ../../filelists/mod-34-Lm.b3.flist
}
DATASTREAM Jcmt_ds34 {
  # MM module says "b2 & b3 DSB"
  # IF signal has band 2 folded on top of band 3
  filelist = ../../filelists/mod-34-Mm.b23.flist
}
DATASTREAM SmaAphids_ds12 {
  filelist = ../../filelists/mod-12-Sw.b3.flist
}
DATASTREAM SmaAphids_ds34 {
  filelist = ../../filelists/mod-34-Sw.b3.flist
}
DATASTREAM Smt_ds12 {
  filelist = ../../filelists/mod-12-Mg.b3.flist
}
DATASTREAM Smt_ds34 {
  filelist = ../../filelists/mod-34-Mg.b3.flist
}
DATASTREAM Aa_ds12 {
  filelist = ../../filelists/mod-12-Aa.b3.flist
}
DATASTREAM Aa_ds34 {
  filelist = ../../filelists/mod-34-Aa.b3.flist
}
DATASTREAM Spt_ds12 {
  filelist = ../../filelists/mod-12-Sz.b3.flist
}
DATASTREAM Spt_ds34 {
  filelist = ../../filelists/mod-34-Sz.b3.flist
}


SETUP MHz58 {
  numBufferedFFTs = 20
  tInt = 0.400
  subintNS =  3200000
  FFTSpecRes = 0.015625
  outputSpecRes = 0.5
  xmacLength = 0
  strideLength = 0
  guardNS = 2000
}

RULE defaultRule {
  setup = MHz58

  # Reference scans
  scan = 115-0314
}
