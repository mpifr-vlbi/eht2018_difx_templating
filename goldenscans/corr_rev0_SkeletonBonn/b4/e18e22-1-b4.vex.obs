     ref $IF = AX_BAND4_IF:Ax;
     ref $IF = PV_BAND4_IF:Pv;
     ref $IF = ALMA_BAND4_IF:Aa;
     ref $IF = SMA_BAND4_IF:Sw;
     ref $IF = JCMT_BAND4_IFR:Mm;
     ref $IF = GLT_BAND4_IF:Gl;
     ref $BBC = ALMA_BBC:Aa;
     ref $BBC = COMMON_BBC:Pv:Ax:Sz:Sw:Mg;
     ref $BBC = REVERSE_BBC:Lm:Gl;  ** rev1 F008
     ref $BBC = COMMON_BBC_1POL_R:Mm;
     ref $TRACKS = VDIF.8224:Ax:Lm:Pv:Mm:Sw:Sz:Gl:Mg;
     ref $TRACKS = VDIF.8032:Aa;
     ref $PHASE_CAL_DETECT = NoDetect:Aa:Ax:Lm:Pv:Mm:Sw:Sz:Mg;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*------------------------------------------------------------------------------
$DAS;
*
def 2NONE<;
     record_transport_type = Mark6;
     electronics_rack_type = none;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*
def 2NONE<#02;
     record_transport_type = Mark5C;
     electronics_rack_type = none;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Aa;
     ref $SITE = ALMA;
     ref $ANTENNA = ALMA;
     ref $DAS = 2NONE<;
enddef;
*
def Ax;
     ref $SITE = APEX;
     ref $ANTENNA = APEX;
     ref $DAS = 2NONE<;
enddef;
*
def Pv;
     ref $SITE = PICOVEL;
     ref $ANTENNA = PICOVEL;
     ref $DAS = 2NONE<#02;
